# ============================================================
# DJANGO
# ============================================================
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# ============================================================
# SUPABASE POSTGRESQL - SHARED / SESSION POOLER
# Copy these values from: Supabase -> Connect -> Shared pooler
# ============================================================
DB_NAME=postgres
DB_USER=postgres.your-project-ref
DB_PASSWORD=replace-with-supabase-database-password
DB_HOST=aws-0-your-region.pooler.supabase.com
DB_PORT=5432
DB_SSLMODE=require

# Persistent connection / transient-failure hardening
DB_CONN_MAX_AGE=30
DB_CONN_HEALTH_CHECKS=True
DB_CONNECT_TIMEOUT=10
DB_KEEPALIVES_IDLE=30
DB_KEEPALIVES_INTERVAL=10
DB_KEEPALIVES_COUNT=3

# ============================================================
# BUSINESS CONFIGURATION
# ============================================================
LOCAL_CURRENCY=VES
DEFAULT_EXCHANGE_RATE=1.0

# ============================================================
# EXTERNAL EXCHANGE-RATE SERVICE
# ============================================================
EXCHANGE_RATE_API_URL=https://api.exchangerate-api.com/v4/latest/USD
EXCHANGE_RATE_TIMEOUT=5
